                                                                <div class="notify-icon bg-img align-self-center">
                                                                    <img class="img-fluid" src="~/assets/img/avtar/04.jpg" alt="user4">
                                                                </div>
                                                                <div class="notify-message">
                                                                    <p class="font-weight-bold">Smithmin Leyon</p>
