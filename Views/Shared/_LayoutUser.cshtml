                    <!-- end navigation -->
                </nav>
                <!-- end navbar -->
            </header>
            <!-- end app-header -->
            <!-- begin app-container -->
            <div class="app-container">
                <!-- begin app-nabar -->
                <aside class="app-navbar">
                    <!-- begin sidebar-nav -->
                    <div class="sidebar-nav scrollbar scroll_light">
                        <ul class="metismenu " id="sidebarNav">
                            <li class="nav-static-title">Personal</li>
                           
                            @* <li> *@
                            @*     <a class="has-arrow" href="javascript:void(0)" aria-expanded="false"><i class="nav-icon ti ti-calendar"></i><span class="nav-title">Calendar</span></a> *@
                            @*     <ul aria-expanded="false"> *@
                            @*         <li> <a href="@Url.Action("calendar_list","Home")">Calendar List</a> </li> *@
                            @*     </ul> *@
                            @* </li> *@

                          
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center justify-content-between" asp-controller="LeaveApplications" asp-action="Index">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-calendar-check me-2"></i>
                                        <span class="nav-title">My Leave Applications</span>
                                    </span>
                                    @if (ViewBag.LeaveUnread != null && ViewBag.LeaveUnread > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@ViewBag.LeaveUnread</span>
                                    }
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary text-white" href="@Url.Action("Create", "LeaveApplications")">
                                    Apply Leave
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center justify-content-between" asp-controller="Salaries" asp-action="MySalaries">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-cash-coin me-2"></i>
                                        <span class="nav-title">My Salary</span>
                                    </span>
                                    @if (ViewBag.SalaryUnread != null && ViewBag.SalaryUnread > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@ViewBag.SalaryUnread</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link d-flex align-items-center justify-content-between" href="#" data-bs-toggle="dropdown">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-chat-left-text me-2"></i>
                                        <span class="nav-title">Chat</span>
                                    </span>

                                    @{
                                        int totalUnread = 0;
                                        var counts = ViewBag.UnreadCounts as IEnumerable<dynamic>;
                                        if (counts != null)
                                        {
                                            totalUnread = counts.Sum(x => (int)x.Count);
                                        }
                                    }

                                    @if (totalUnread > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@totalUnread</span>
                                    }
                                </a>

                                <ul class="dropdown-menu">
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var employee in Model)
                                        {
                                            <li>
                                                <a class="dropdown-item d-flex justify-content-between"
                                                   asp-controller="Chat"
                                                   asp-action="ChatWithUser"
                                                   asp-route-toUserId="@employee.Id">
                                                    @employee.FullName
                                                    @if (employee.UnreadCount > 0)
                                                    {
                                                        <span class="badge bg-danger rounded-pill">@employee.UnreadCount</span>
                                                    }
                                                </a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="dropdown-item">No employees found.</li>
                                    }
                                </ul>

                            </li>


                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PerformanceEvaluations" asp-action="MyEvaluations">
                                    MyEvaluations
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center justify-content-between" asp-controller="Attendances" asp-action="MyAttendance">
                                    <span class="d-flex align-items-center">
                                        <i class="bi bi-calendar-check2 me-2"></i>
                                        <span class="nav-title">My Attendance</span>
                                    </span>
                                    @if (ViewBag.AttendanceUnread != null && ViewBag.AttendanceUnread > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@ViewBag.AttendanceUnread</span>
                                    }
                                </a>
                            </li>
                            <li class="dropdown">
                                <a href="#" class="menu-toggle nav-link has-dropdown">
                                    <i data-feather="message-square"></i><span>Calendar</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a asp-action="EmployeeEvents" asp-controller="Event">Calendar</a></li>
                                    @* <li><a asp-action="AdminChat" asp-controller="Chat">Admin Chat</a></li> *@
                                </ul>
                            </li>


                        </ul>
