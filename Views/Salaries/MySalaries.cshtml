@model IEnumerable<EmployeeManagement.Models.Salary>
@{
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    ViewData["Title"] = "My Salaries";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold">My Salaries</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No salary records found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover table-bordered text-center align-middle mb-0">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Month</th>
                            <th>Year</th>
                            <th>Basic Pay</th>
                            <th>Allowances</th>
                            <th>Deductions</th>
                            <th><b>Net Pay</b></th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Month</td>
                                <td>@item.Year</td>
                                <td>@item.BasicPay.ToString("C")</td>
                                <td>@item.Allowances.ToString("C")</td>
                                <td>@item.Deductions.ToString("C")</td>
                                <td><b>@item.NetPay.ToString("C")</b></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.SalaryId" class="btn btn-sm btn-info me-1">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-action="GeneratePdf" asp-route-id="@item.SalaryId" class="btn btn-sm btn-success">
                                        <i class="fa fa-download"></i> Generate PDF
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
