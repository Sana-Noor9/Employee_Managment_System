@model EmployeeManagement.Models.Salary

@{
    Layout = null;
    <!-- PDF ke liye layout remove -->
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Salary Slip</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        .container {
            width: 700px;
            margin: auto;
            border: 1px solid #000;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: left;
        }

        .summary {
            margin-top: 20px;
        }

        .footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Salary Slip</h2>

        <p><b>Employee:</b> @Model.User.FullName</p>
        <p><b>Month:</b> @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year</p>

        <table>
            <tr>
                <th>Basic Pay</th>
                <td>@Model.BasicPay.ToString("C")</td>
            </tr>
            <tr>
                <th>Allowances</th>
                <td>@Model.Allowances.ToString("C")</td>
            </tr>
            <tr>
                <th>Deductions</th>
                <td>@Model.Deductions.ToString("C")</td>
            </tr>
            <tr>
                <th><b>Net Pay</b></th>
                <td><b>@Model.NetPay.ToString("C")</b></td>
            </tr>
        </table>

        <div class="summary">
            <p><b>Date Generated:</b> @DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>

        <div class="footer">
            <p>-- End of Salary Slip --</p>
        </div>
    </div>
</body>
</html>
