@using System.Linq
@model List<EmployeeManagement.Models.ViewModels.LeaveReportViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center fw-bold text-primary mb-4">
        Leave Report - @ViewBag.Month
    </h2>

    <div class="text-end mb-3">
        <a href="@Url.Action("LeaveReportPdf", "Reports")" class="btn btn-outline-danger">
            <i class="fa fa-file-pdf"></i> Download PDF
        </a>
        <a href="@Url.Action("Index", "Account")" class="btn btn-outline-secondary ms-2">
            <i class="fa fa-arrow-left"></i> Back
        </a>
    </div>

    <table class="table table-striped table-bordered table-hover text-center shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Employee</th>
                <th>Total Leaves</th>
                <th>Approved</th>
                <th>Rejected</th>
                <th>Pending</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                            <tr>
                                <td>@item.Employee</td>
                                <td>@item.TotalLeaves</td>
                                <td>@item.Approved</td>
                                <td>@item.Rejected</td>
                                <td>@item.Pending</td>
                            </tr>
                }
            }
            else
            {
                    <tr>
                        <td colspan="5" class="text-muted">No leave records found for @ViewBag.Month</td>
                    </tr>
            }
        </tbody>
    </table>
</div>
