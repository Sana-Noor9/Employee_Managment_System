@model EmployeeManagement.Models.PerformanceEvaluation

@{
    ViewData["Title"] = "Edit Performance Evaluation";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm p-4" style="max-width: 700px; width: 100%;">
        <h3 class="text-center mb-4">Edit Performance Evaluation</h3>

        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EvaluationId" />

            <!-- Employee -->
            <div class="col-md-6">
                <label asp-for="UserId" class="form-label">Employee</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <!-- Date -->
            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Evaluation Date</label>
                <input asp-for="Date" class="form-control" type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <!-- Score -->
            <div class="col-md-6">
                <label asp-for="Score" class="form-label">Score</label>
                <input asp-for="Score" class="form-control" type="number" step="1" min="1" max="10" placeholder="1-10" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>

            <!-- Comments -->
            <div class="col-md-12">
                <label asp-for="Comments" class="form-label">Comments</label>
                <textarea asp-for="Comments" class="form-control" rows="3" placeholder="Enter feedback or remarks"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="col-12 mt-3 d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
