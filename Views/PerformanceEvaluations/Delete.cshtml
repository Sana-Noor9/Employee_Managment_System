@model EmployeeManagement.Models.PerformanceEvaluation

@{
    ViewData["Title"] = "Delete Evaluation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg">
                <div class="card-header bg-danger text-white text-center">
                    <h3>Delete Performance Evaluation</h3>
                </div>
                <div class="card-body text-center">
                    <h5 class="text-muted mb-4">Are you sure you want to delete this evaluation?</h5>
                    <hr />

                    <dl class="row text-start">
                        <dt class="col-sm-3 fw-bold">Employee</dt>
                        <dd class="col-sm-9">@Model.User.FullName</dd>

                        <dt class="col-sm-3 fw-bold">Date</dt>
                        <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

                        <dt class="col-sm-3 fw-bold">Score</dt>
                        <dd class="col-sm-9">@Model.Score</dd>

                        <dt class="col-sm-3 fw-bold">Comments</dt>
                        <dd class="col-sm-9">@Model.Comments</dd>
                    </dl>

                    <form asp-action="DeleteConfirmed" class="mt-4">
                        <input type="hidden" asp-for="EvaluationId" />
                        <button type="submit" class="btn btn-danger px-4">Delete</button>
                        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancel</a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
