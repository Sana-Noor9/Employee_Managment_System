@model EmployeeManagement.Models.PerformanceEvaluation

@{
    ViewData["Title"] = "Add Performance Evaluation";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm p-4" style="max-width: 700px; width: 100%;">
        <h3 class="text-center mb-4">Add Performance Evaluation</h3>

        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <!-- Employee Dropdown -->
            <div class="col-12">
                <label asp-for="UserId" class="form-label">Employee</label>
                <select asp-for="UserId" asp-items="@(ViewData["UserId"] as SelectList)" class="form-select">
                   
                    <option value="">-- Select Employee --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <!-- Evaluation Date -->
            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Evaluation Date</label>
                <input asp-for="Date" class="form-control" type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <!-- Score -->
            <div class="col-md-6">
                <label asp-for="Score" class="form-label">Score</label>
                <input asp-for="Score" class="form-control" type="number" min="1" max="10" step="1" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>

            <!-- Comments -->
            <div class="col-12">
                <label asp-for="Comments" class="form-label">Comments</label>
                <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="col-12 mt-3 d-flex justify-content-between">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
