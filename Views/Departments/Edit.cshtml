@model EmployeeManagement.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm w-50">
        <div class="card-body">
            <h2 class="text-center fw-bold mb-4">Edit Department</h2>
            <hr />

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="DepartmentId" />

                <div class="mb-3">
                    <label asp-for="DepartmentName" class="form-label fw-bold"></label>
                    <input asp-for="DepartmentName" class="form-control" />
                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-save"></i> Save
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
