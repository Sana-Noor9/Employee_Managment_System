@model EmployeeManagement.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm w-50">
        <div class="card-body text-center">
            <h2 class="fw-bold text-danger mb-3">Delete Department</h2>
            <p class="text-muted">Are you sure you want to delete this department?</p>
            <hr />

            <dl class="row justify-content-center">
                <dt class="col-sm-4 fw-bold">
                    @Html.DisplayNameFor(model => model.DepartmentName)
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.DepartmentName)
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="DepartmentId" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </form>
        </div>
    </div>
</div>
