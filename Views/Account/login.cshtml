@model EmployeeManagement.Models.LoginViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #ffffff, #f3e8ff, #e0b3ff);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-box {
            width: 900px;
            max-width: 95%;
            display: flex;
            border-radius: 15px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 8px 30px rgba(155, 0, 255, 0.3);
        }

        /* Left section (Form) */
        .login-left {
            flex: 1;
            background: #fff;
            padding: 50px;
        }

            .login-left h2 {
                margin-bottom: 30px;
                font-weight: 700;
                color: #5a00ff;
            }

        .form-control {
            background: #f9f9f9;
            border: 1px solid #ccc;
            color: #333;
            border-radius: 8px;
            padding: 12px;
        }

            .form-control:focus {
                border-color: #9b00ff;
                box-shadow: 0 0 10px rgba(155, 0, 255, 0.4);
            }

        .btn-login {
            background: linear-gradient(90deg, #9b00ff, #5a00ff);
            border: none;
            border-radius: 25px;
            padding: 12px;
            color: #fff;
            font-weight: bold;
            margin-top: 10px;
            width: 100%;
            transition: 0.3s;
        }

            .btn-login:hover {
                opacity: 0.9;
                box-shadow: 0 0 15px rgba(155, 0, 255, 0.8);
            }

        .login-left a {
            color: #5a00ff;
            text-decoration: none;
        }

            .login-left a:hover {
                text-decoration: underline;
            }

        /* Right Section (Image) */
        .login-right {
            flex: 1;
            background: url('@Url.Content("~/assets/img/logo2.png")') no-repeat center center;
            background-size: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            position: relative;
        }
            /* Overlay for readability */
            .login-right::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(90, 0, 255, 0.4);
            }

            .login-right h1 {
                font-size: 2rem;
                font-weight: bold;
                z-index: 2;
            }

    </style>
</head>
<body>
    <div class="login-box">
        <!-- Left Form Section -->
        <div class="login-left">
            <h2>Login</h2>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Email -->
                <div class="mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Button -->
                <button type="submit" class="btn btn-login">Login</button>

                <!-- Register -->
                <p class="mt-3">
                    Don’t have an account?

                </p>
            </form>
        </div>

        <!-- Right Image Section -->
        <div class="login-right">
            <h1>WELCOME BACK!</h1>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
