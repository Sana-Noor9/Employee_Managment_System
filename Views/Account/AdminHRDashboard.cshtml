@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Fallback values if ViewBag is not set
    var newBookings = ViewBag.NewBookings ?? 0;
    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var newProjects = ViewBag.NewProjects ?? 0;
    var revenue = ViewBag.Revenue ?? 0.0;
    var bookingChange = ViewBag.BookingChange ?? 0;
    var customerChange = ViewBag.CustomerChange ?? 0;
    var projectChange = ViewBag.ProjectChange ?? 0;
    var revenueChange = ViewBag.RevenueChange ?? 0;
}
<div class="main-content">
    <section class="section">
        <div class="row">

            <!-- New Bookings Card -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <div class="card">
                    <div class="card-statistic-4">
                        <div class="align-items-center justify-content-between">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                                    <div class="card-content">
                                        <h5 class="font-15">New Bookings</h5>
                                        <h2 class="mb-3 font-18">@newBookings</h2>
                                        <p class="mb-0">
                                            <span class="@(bookingChange >= 0 ? "col-green" : "col-red")">
                                                @bookingChange% @(bookingChange >= 0 ? "Increase" : "Decrease")
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pl-0">
                                    <div class="banner-img">
                                        <img src="assets/img/banner/1.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customers Card -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <div class="card">
                    <div class="card-statistic-4">
                        <div class="align-items-center justify-content-between">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                                    <div class="card-content">
                                        <h5 class="font-15">Customers</h5>
                                        <h2 class="mb-3 font-18">@totalCustomers</h2>
                                        <p class="mb-0">
                                            <span class="@(customerChange >= 0 ? "col-green" : "col-orange")">
                                                @customerChange% @(customerChange >= 0 ? "Increase" : "Decrease")
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pl-0">
                                    <div class="banner-img">
                                        <img src="assets/img/banner/2.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- New Projects Card -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <div class="card">
                    <div class="card-statistic-4">
                        <div class="align-items-center justify-content-between">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                                    <div class="card-content">
                                        <h5 class="font-15">New Projects</h5>
                                        <h2 class="mb-3 font-18">@newProjects</h2>
                                        <p class="mb-0">
                                            <span class="@(projectChange >= 0 ? "col-green" : "col-red")">
                                                @projectChange% @(projectChange >= 0 ? "Increase" : "Decrease")
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pl-0">
                                    <div class="banner-img">
                                        <img src="assets/img/banner/3.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Revenue Card -->
            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <div class="card">
                    <div class="card-statistic-4">
                        <div class="align-items-center justify-content-between">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pr-0 pt-3">
                                    <div class="card-content">
                                        <h5 class="font-15">Revenue</h5>
                                        <h2 class="mb-3 font-18">$@String.Format("{0:N0}", revenue)</h2>
                                        <p class="mb-0">
                                            <span class="@(revenueChange >= 0 ? "col-green" : "col-red")">
                                                @revenueChange% @(revenueChange >= 0 ? "Increase" : "Decrease")
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 pl-0">
                                    <div class="banner-img">
                                        <img src="assets/img/banner/4.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>
