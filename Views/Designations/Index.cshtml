@model IEnumerable<EmployeeManagement.Models.Designation>

@{
    ViewData["Title"] = "Designations";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm w-75">
        <div class="card-body">
            <h2 class="text-center fw-bold mb-4">Designations</h2>

            <div class="text-center mb-3">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New
                </a>
            </div>

            <table class="table table-bordered table-hover text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Designation Name</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.DesignationName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Department.DepartmentName)</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.DesignationId" class="btn btn-sm btn-warning me-2">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.DesignationId" class="btn btn-sm btn-info me-2 text-white">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.DesignationId" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-muted">No designations available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
